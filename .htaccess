# Paikit Health Center - Clean URLs Configuration
Options -MultiViews
RewriteEngine On

# 1. Externally redirect index.php to directory path (e.g. /paikit/index.php -> /paikit/)
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.*?/)index\.php([?\s]|$) [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# 2. Externally redirect any direct browser request with .php to clean URL (strip .php)
# e.g. /paikit/doctor/dashboard.php -> /paikit/doctor/dashboard
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{REQUEST_URI} !/api/ [NC]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.*?)\.php([?\s]|$) [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# 3. Internally resolve clean URL to .php file if it exists
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*?)/?$ $1.php [L,QSA]
